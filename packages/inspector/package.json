{
  "name": "@evgkch/machjs-inspector",
  "version": "0.0.9",
  "description": "Look at a state machine: three projections of its transition relation, drawn from the graph and driven by two clicks. Reads a dumped schema, or attaches to a machine that is running",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist-lib/ui.js"
  ],
  "files": [
    "dist-lib",
    "README.ru.md"
  ],
  "main": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "default": "./dist-lib/index.js"
    },
    "./ui": {
      "types": "./dist-lib/ui.d.ts",
      "default": "./dist-lib/ui.js"
    },
    "./style.css": "./dist-lib/ui.css",
    "./tokens.css": "./dist-lib/tokens.css"
  },
  "scripts": {
    "dev": "vite",
    "inspect": "node scripts/relay.mjs & vite --open /viewer.html",
    "relay": "node scripts/relay.mjs",
    "build": "npm run build:lib && npm run build:site",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/bare-dts.mjs",
    "build:site": "npm run dump && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dump": "node --no-warnings scripts/dump.mjs",
    "test": "node scripts/matrix.mjs",
    "matrix": "node scripts/matrix.mjs",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "peerDependencies": {
    "@evgkch/chanjs": ">=1.0.0",
    "@evgkch/machjs": ">=0.5.0"
  },
  "devDependencies": {
    "@evgkch/chanjs": "^1.0.0",
    "@evgkch/machjs": "*",
    "happy-dom": "^20.11.2",
    "vite": "^8.2.0",
    "ws": "^8.21.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/evgkch/machjs.git",
    "directory": "packages/inspector"
  },
  "homepage": "https://evgkch.github.io/machjs/inspector/",
  "bugs": {
    "url": "https://github.com/evgkch/machjs/issues"
  },
  "keywords": [
    "fsm",
    "state-machine",
    "mealy",
    "inspector",
    "devtools",
    "visualisation"
  ],
  "author": "Evgeny Kucherenko",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
